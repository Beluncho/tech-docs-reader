# ===== Стенд «Техническая документация» =====
# Скопируйте в .env и заполните нужное. Пустые ключи = детерминированный режим без облака.

# Порт UI
UI_PORT=8081

# --- OCR ---
# В docker: http://ocr:8300 (поднять: docker compose --profile ocr up -d)
# В локальной разработке можно оставить пустым — OCR недоступен, сканы не распознаются.
OCR_SERVICE_URL=http://ocr:8300

# --- LLM: YandexGPT (OpenAI-совместимый эндпоинт) ---
LLM_PROVIDER=yandexgpt
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_API_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Основная модель
YANDEXGPT_RULE_MODEL=qwen3-235b-a22b-fp8/latest
# Модели фолбэка через запятую (перебираются по порядку)
YANDEXGPT_RULE_MODELS=qwen3-235b-a22b-fp8/latest,qwen3.6-35b-a3b/latest,deepseek-v4-flash/latest,yandexgpt-5.1/latest
# Альтернатива: общий ключ (если используется не YandexGPT)
# LLM_API_KEY=
LLM_TIMEOUT_SEC=120
# Повторы при сетевых сбоях (DNS/таймаут) и JSON-режим ответа (не все модели Яндекса его поддерживают)
LLM_RETRIES=2
LLM_JSON_MODE=0

# --- Ограничения и рендер ---
MAX_UPLOAD_MB=50
PAGE_RENDER_ZOOM=2.0
